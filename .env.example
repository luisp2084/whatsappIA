# --- WhatsApp Cloud API (Meta Developers) ---
WA_TOKEN=            # token permanente de System User
WA_PHONE_NUMBER_ID=  # ID del número (no el número de teléfono)
WA_APP_SECRET=       # App Secret, para validar X-Hub-Signature-256
WA_VERIFY_TOKEN=     # cadena aleatoria que pegas también en la config del webhook
GRAPH_VERSION=v23.0

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
THINKING_BUDGET=0    # vacío = valor por defecto del modelo

# --- Estado y cola ---
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=local     # local | pubsub
PUBSUB_TOPIC=        # projects/<proyecto>/topics/wa-inbound
PUBSUB_PUSH_TOKEN=   # secreto en la URL de push: /tasks/pubsub?token=...

# --- Operación ---
DEBOUNCE_SECONDS=2.0
SESSION_TTL_SECONDS=604800
HANDOFF_WEBHOOK_URL= # tu inbox humano
ADMIN_TOKEN=         # protege POST /handoff/release
PSEUDONYM_PEPPER=    # clave para seudonimizar wa_id en logs (guárdala en Secret Manager)
