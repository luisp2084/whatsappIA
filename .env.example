# --- WhatsApp Cloud API (Meta Developers) ---
WA_TOKEN=            # token permanente de System User
WA_PHONE_NUMBER_ID=  # ID del número (no el número de teléfono)
WA_APP_SECRET=       # App Secret, para validar X-Hub-Signature-256
WA_VERIFY_TOKEN=     # cadena aleatoria que pegas también en la config del webhook
GRAPH_VERSION=v23.0

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash              # revisa https://ai.google.dev/gemini-api/docs/deprecations
GEMINI_FALLBACK_MODEL=gemini-flash-latest  # alias: siempre el Flash más reciente
CLASSIFIER_MODEL=gemini-flash-lite-latest  # clasificador de áreas; vacío = palabras clave
THINKING_BUDGET=     # solo modelos gemini-2.5 (0 = sin "thinking"); vacío = valor por defecto

# --- Datos ---
DATABASE_URL=sqlite+aiosqlite:///./whatsappia.db  # producción: postgresql+asyncpg://usuario:clave@host/db
REDIS_URL=redis://localhost:6379/0
QUEUE_MODE=local     # local | pubsub
PUBSUB_TOPIC=        # projects/<proyecto>/topics/wa-inbound
PUBSUB_PUSH_TOKEN=   # secreto en la URL de push: /tasks/pubsub?token=...

# --- Integraciones del ISP ---
ISP_BACKEND=fake     # fake = datos de ejemplo. Añade tu adaptador de Network Control/OLT en app/isp.py

# --- Panel y seguridad ---
SECRET_KEY=          # obligatorio: firma las sesiones del panel (32+ caracteres aleatorios)
OWNER_EMAIL=         # crea el primer owner si aún no hay usuarios
OWNER_PASSWORD=      # mín. 10 caracteres; cámbiala tras el primer acceso
PSEUDONYM_PEPPER=    # clave para seudonimizar wa_id en logs
HANDOFF_WEBHOOK_URL= # opcional: avisar también a otro inbox (Chatwoot, Zendesk...)

# --- Operación ---
ROLE=all             # all | webhook | worker | sender | console
DEBOUNCE_SECONDS=4.0
SESSION_TTL_SECONDS=604800
