{
  "name": "Agente WhatsApp (demo)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "pip install --user -r requirements-dev.txt",
  "postAttachCommand": "pip install --user -q -r requirements-dev.txt && python -m app.demo",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Panel del agente", "onAutoForward": "openBrowser" }
  },
  "secrets": {
    "GEMINI_API_KEY": {
      "description": "Opcional. Clave de Google AI Studio para que la demo use Gemini real en lugar de reglas simples.",
      "documentationUrl": "https://aistudio.google.com/apikey"
    }
  },
  "customizations": {
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
